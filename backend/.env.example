# Canvas credentials
CANVAS_BASE_URL=https://<your-domain>.instructure.com/api/v1
CANVAS_TOKEN=your_canvas_token

# Bedrock via OpenAI-compatible API
# Paste your Bedrock API key from AWS Console → Bedrock → Quickstart
# Model A (e.g. Claude Sonnet)
MODEL_A_API_KEY=BedrockAPIKey-...
MODEL_A_BASE_URL="https://bedrock-mantle.ap-southeast-2.api.aws/v1"
MODEL_A_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Model B (e.g. GPT testing; swap to Llama later)
MODEL_B_API_KEY=BedrockAPIKey-...
MODEL_B_BASE_URL="https://bedrock-mantle.ap-southeast-2.api.aws/v1"
MODEL_B_ID=openai.gpt-oss-120b

# Pipeline settings
CONFIDENCE_THRESHOLD=0.85

AWS_ACCESS_KEY_ID=<from terraform output>
AWS_SECRET_ACCESS_KEY=<from terraform output -raw aws_secret_access_key>