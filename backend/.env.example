# Canvas credentials (optional — only needed if testing "Sync to Canvas")
CANVAS_BASE_URL="https://learningvault.instructure.com"
CANVAS_TOKEN=

# Model configuration — pick ONE option, uncomment its lines, fill in your own API key.
# See README/docs for how MODEL_A (extractor) and MODEL_B (verifier) are used.

# --- Option A: Direct Anthropic API (recommended if you have a Claude API key) ---
# Model IDs look like "claude-haiku-4-5-20251001" — see
# https://docs.anthropic.com/en/docs/about-claude/models for current IDs.
MODEL_A_API_KEY="sk-ant-..."
MODEL_A_BASE_URL=
MODEL_A_ID="claude-haiku-4-5-20251001"
MODEL_A_PROVIDER="anthropic"

MODEL_B_API_KEY="sk-ant-..."
MODEL_B_BASE_URL=
MODEL_B_ID="claude-haiku-4-5-20251001"
MODEL_B_PROVIDER="anthropic"

# --- Option B: Direct OpenAI API ---
# MODEL_A_API_KEY="sk-..."
# MODEL_A_BASE_URL="https://api.openai.com/v1"
# MODEL_A_ID="gpt-4o-mini"
# MODEL_A_PROVIDER="openai"
#
# MODEL_B_API_KEY="sk-..."
# MODEL_B_BASE_URL="https://api.openai.com/v1"
# MODEL_B_ID="gpt-4o-mini"
# MODEL_B_PROVIDER="openai"

# --- Option C: AWS Bedrock (only if you have your own AWS account with Bedrock access) ---
# MODEL_A_API_KEY=
# MODEL_A_BASE_URL=
# MODEL_A_ID="global.anthropic.claude-haiku-4-5-20251001-v1:0"
# MODEL_A_PROVIDER="bedrock"
#
# MODEL_B_API_KEY=
# MODEL_B_BASE_URL=
# MODEL_B_ID="global.anthropic.claude-haiku-4-5-20251001-v1:0"
# MODEL_B_PROVIDER="bedrock"

# AWS creds — only needed if using Option C (Bedrock) above. Leave blank otherwise.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2

# File storage — local MinIO (via docker-compose), no AWS account needed.
S3_BUCKET=lms-management-uploads
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Database — matches docker-compose.yml's postgres service, no changes needed
# unless you changed those values.
DATABASE_URL=postgresql://lms:lms@localhost:5432/lms